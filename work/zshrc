# Work-host zsh config, installed by work/bootstrap.sh (the --no-nix path).
# Personal-mac gets its zshrc generated by home-manager from home.nix's
# programs.zsh block instead — this file must never be linked there.

# brew isn't on PATH yet in a fresh shell, so shellenv has to be found at one
# of Homebrew's two possible prefixes (Apple Silicon vs Intel) before it can
# report its own prefix.
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

export PATH="$HOME/.local/bin:$PATH"
export EDITOR=nvim

alias vim=nvim
alias bx="bundle exec"
alias cssh="infocmp -x xterm-ghostty | ssh gh codespace ssh tic -x -h"
alias cc=claude

eval "$(rbenv init - zsh)"

# From here on brew is on PATH, so its prefix can be asked for directly.
brew_prefix="$(brew --prefix)"
# shellcheck disable=SC1091
[ -f "$brew_prefix/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ] &&
  source "$brew_prefix/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
# shellcheck disable=SC1091
[ -f "$brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ] &&
  source "$brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
unset brew_prefix

eval "$(starship init zsh)"
eval "$(direnv hook zsh)"

[ -f ~/.zshrc.local ] && source ~/.zshrc.local
