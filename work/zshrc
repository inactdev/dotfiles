# Work-host zsh config, installed by both work/bootstrap.sh (Mac,
# Homebrew) and work/codespace-bootstrap.sh (codespace-work, no-nix apt
# path) - one file, self-detecting Homebrew vs apt at runtime, rather
# than two files someone has to keep in sync by hand every time either
# host's tool set changes. Personal-mac gets its zshrc generated by
# home-manager from modules/core.nix's programs.zsh block instead - this
# file must never be linked there.

# brew isn't on PATH yet in a fresh shell, so shellenv has to be found at
# one of Homebrew's two possible prefixes (Apple Silicon vs Intel) before
# it can report its own prefix. No-ops cleanly on a codespace, which has
# no Homebrew at all.
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

export PATH="$HOME/.local/bin:$PATH"
export EDITOR=nvim

alias vim=nvim
alias bx="bundle exec"
alias cssh="infocmp -x xterm-ghostty | ssh gh codespace ssh tic -x -h"
alias cc=claude

# Guarded, not host-split: rbenv is installed via Brewfile on the Mac and
# via apt on a codespace (work/codespace-bootstrap.sh) - either way, this
# no-ops cleanly if it's genuinely missing, same pattern modules/core.nix
# already uses for the Nix-based hosts.
if command -v rbenv >/dev/null 2>&1; then
  eval "$(rbenv init - zsh)"
fi

# Homebrew installs zsh-autosuggestions/zsh-syntax-highlighting under its
# own prefix; apt (work/codespace-bootstrap.sh's install_zsh_plugin_packages)
# installs the same two packages under /usr/share instead - branch on
# which package manager is actually present rather than threading a
# host flag through this file.
if command -v brew >/dev/null 2>&1; then
  brew_prefix="$(brew --prefix)"
  # shellcheck disable=SC1091
  [ -f "$brew_prefix/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ] &&
    source "$brew_prefix/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  # shellcheck disable=SC1091
  [ -f "$brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ] &&
    source "$brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
  unset brew_prefix
else
  # shellcheck disable=SC1091
  [ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ] &&
    source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
  # shellcheck disable=SC1091
  [ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] &&
    source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# Guarded (unlike the Mac path historically was): a codespace's starship/
# direnv come from a network download (work/codespace-bootstrap.sh) that
# can legitimately fail and land in its PENDING summary instead of
# hard-failing the whole install, so a fresh shell must not error out
# just because one of them didn't make it - see AGENTS.md.
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi
if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook zsh)"
fi

[ -f ~/.zshrc.local ] && source ~/.zshrc.local
