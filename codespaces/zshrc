# Codespaces zsh config, installed by install.sh for both personal and work
# postures - GitHub Codespaces auto-clones this repo and runs install.sh
# non-interactively at container creation. Never linked on personal-mac or
# home-linux, which get their zshrc generated by home-manager instead.

export PATH="$HOME/.local/bin:$PATH"
export EDITOR=nvim

alias vim=nvim
alias bx="bundle exec"
alias cc=claude

# shellcheck disable=SC1091
[ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ] &&
  source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
# shellcheck disable=SC1091
[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] &&
  source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

eval "$(starship init zsh)"
eval "$(direnv hook zsh)"

[ -f ~/.zshrc.local ] && source ~/.zshrc.local
