#!/usr/bin/env bash
#
# dotfiles-auto-apply - keep this machine's dotfiles current without anyone
# having to remember to.
#
# Fetches ~/.dotfiles' origin and, when origin/master has moved ahead of a
# clean master checkout, fast-forwards to it. What happens *after* that
# depends on which host this machine is, and the host is read from
# .dotfiles-host - the marker run.sh itself reads to know which recipe it
# applies. Never from `uname`, never from the hostname: a scheduled job
# must not guess what run.sh would refuse to guess, so a missing or
# unrecognized marker stops the run instead.
#
#   personal-mac  Announces, and switches nothing. `./run.sh rebuild` ends
#                 in `sudo darwin-rebuild switch` there, and a launchd
#                 *user* agent has no terminal for sudo to prompt at - a
#                 scheduled switch could only ever fail with "sudo: a
#                 terminal is required to read the password" and retry
#                 every half hour. So this host fast-forwards, raises a
#                 notification that an update is ready, logs the one
#                 command to run, and stops. No sudo, no password, ever.
#   home-linux    Applies it with `./run.sh rebuild`, which is a plain
#                 user-level `home-manager switch` - no sudo anywhere in
#                 it, so there is nothing to prompt for.
#   anything else Refuses, naming .dotfiles-host, and fetches nothing.
#
# The OS schedules it - every 30 minutes and once at login - from a launchd
# user agent on personal-mac (modules/mac.nix) and a systemd user timer on
# home-linux (modules/linux.nix). Nothing else runs it, and nothing has to:
# it is also on PATH as `dotfiles-auto-apply` (modules/desktop.nix symlinks
# it into ~/.local/bin) for a run by hand.
#
# The rules, in the order they matter:
#
#   - It never needs a password. The one host whose switch needs root does
#     not switch here at all, and the switch that does run is wrapped in a
#     `sudo` that always carries -n, so anything that ever did ask for a
#     password fails in milliseconds with a log line that says so rather
#     than blocking a job with no terminal.
#   - It never touches a dirty checkout. Any staged or unstaged change, and
#     any untracked file git does not ignore, stops the run before the
#     fast-forward: nothing is merged, nothing is applied, nothing is
#     announced, the log says what is in the way.  A HEAD that is not
#     master stops it the same way.
#   - It only ever fast-forwards. A master that has genuinely diverged from
#     origin/master is never merged, rebased or reset - that one notifies
#     and exits non-zero, because only a human can resolve it.
#   - A fetch it could not act on is never silent. Uncommitted changes,
#     local commits and a real divergence each log their own line and raise
#     one notification per occurrence (not per run) on both hosts.
#   - It never leaves the machine quietly behind. The commit of the last
#     successful rebuild is recorded - by this script on home-linux, and by
#     `./run.sh rebuild` itself wherever it is run by hand - so a rebuild
#     that failed is retried on the next run instead of being forgotten the
#     moment the checkout has caught up with the fetch, and so the Mac's
#     reminder goes quiet the moment the update is actually applied.
#   - Every failure is logged and exits non-zero. The outcomes that need a
#     human notify as well, but only where a notification can be delivered:
#     the notifier is looked up at runtime (osascript, then notify-send),
#     so this same script is correct on the captain's Mac and on a headless
#     cloud box with no D-Bus session, where the log and journald are the
#     record.
#
# Every line goes both to $log_file and to stdout, which the scheduler
# captures too (launchd's StandardOutPath, journald on Linux). See
# notes/20261022-dotfiles-auto-apply-no-password.md for why the Mac only
# announces, and notes/20261021-dotfiles-auto-apply.md for why those are
# two different files and why the unit files point at stable paths rather
# than store paths.
set -euo pipefail

repo=$HOME/.dotfiles
branch=master
remote=origin
remote_ref=refs/remotes/$remote/$branch
host_file=$repo/.dotfiles-host

state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles-auto
log_file=$state_dir/apply.log
state_file=$state_dir/last-applied
announce_file=$state_dir/last-announced
blocked_file=$state_dir/last-blocked
rebuild_out_file=$state_dir/last-rebuild-output
log_max_lines=2000

# The one command a human runs. Written once because it goes out three
# ways - the log, the notification, and this file's own comments - and a
# notification that names the wrong command is worse than none.
rebuild_hint='cd ~/.dotfiles && ./run.sh rebuild'

# --- log, notify ------------------------------------------------------

if ! mkdir -p "$state_dir"; then
  echo "dotfiles-auto-apply: cannot create $state_dir, so there is nowhere to log; giving up." >&2
  exit 1
fi

# One line, appended (never held open) so the trim below can rename the
# file out from under nothing. Also echoed to stdout for the scheduler's
# own capture. A log write that fails must not take the run down with it -
# the rebuild matters more than its record.
log() {
  local line
  line="$(date '+%Y-%m-%dT%H:%M:%S%z') dotfiles-auto-apply: $*"
  printf '%s\n' "$line"
  printf '%s\n' "$line" >>"$log_file" || true
}

warn() {
  local line
  line="$(date '+%Y-%m-%dT%H:%M:%S%z') dotfiles-auto-apply: $*"
  printf '%s\n' "$line" >&2
  printf '%s\n' "$line" >>"$log_file" || true
}

# Keeps the log to its last $log_max_lines, on every exit path (see the trap
# below) rather than only the happy one. Writing a tail to a temp file and
# renaming it is why nothing may hold the log open: a scheduler told to
# capture stdout into this same path would keep writing to the unlinked
# inode afterwards, which is why launchd is pointed at ~/Library/Logs
# instead. Never fails the run - a log that could not be trimmed is a log
# that is merely too long.
trim_log() {
  [ -f "$log_file" ] || return 0
  local tmp=$log_file.trim
  if tail -n "$log_max_lines" "$log_file" >"$tmp" 2>/dev/null; then
    mv -f "$tmp" "$log_file" 2>/dev/null || rm -f "$tmp"
  else
    rm -f "$tmp"
  fi
  return 0
}

trap 'trim_log || true' EXIT

# Best-effort desktop notification, for the outcomes a human has to act
# on. The notifier is whatever this machine actually has: osascript on the
# Mac, notify-send on a Linux box with a desktop session, nothing at all on
# a headless one - where the log and the scheduler's own capture are the
# record, which is why a missing or failing notifier is never an error.
#
# The message is stripped of " and \ because osascript's argument is
# AppleScript source rather than an argv slot. The strip is a parameter
# expansion rather than `tr -d`, whose delete set would have to spell a
# backslash as '\\' inside single quotes - two characters tr folds back to
# one, which reads as a quoting mistake to both people and shellcheck.
notify() {
  local title=$1 message=$2 safe
  safe=${message//[\"\\]/}
  if command -v osascript >/dev/null 2>&1; then
    if ! osascript -e "display notification \"$safe\" with title \"$title\"" >/dev/null 2>&1; then
      log "osascript could not deliver the notification; the log above is the record."
    fi
  elif command -v notify-send >/dev/null 2>&1; then
    if ! notify-send --urgency=critical -- "$title" "$safe" >/dev/null 2>&1; then
      log "notify-send could not deliver the notification (no desktop session?); the log above is the record."
    fi
  else
    log "no desktop notifier on this machine (no osascript, no notify-send); the log above is the record."
  fi
}

# One notification per *occurrence* of a fetch that could not be acted on,
# not one per run: $1 is a key that changes only when the situation does
# (its kind plus the two commits involved), so an uncommitted edit left in
# ~/.dotfiles over a weekend interrupts once instead of 48 times. The log
# line is written by the caller either way - the notification is the thing
# that is deduplicated, because the log is the record.
notify_once() {
  local key=$1 title=$2 message=$3 seen
  seen=$(cat "$blocked_file" 2>/dev/null) || seen=""
  if [ "$seen" = "$key" ]; then
    log "already notified about this; the line above is the record until it is dealt with."
    return 0
  fi
  notify "$title" "$message"
  printf '%s\n' "$key" >"$blocked_file" || true
}

# Forgets the last such occurrence, so the next one notifies again even if
# it is the same kind. Called on every path where nothing is in the way.
clear_notified_once() {
  rm -f "$blocked_file" 2>/dev/null || true
  return 0
}

# --- the checkout -----------------------------------------------------

# The same shape of check run.sh makes on its own directory: a ~/.dotfiles
# that is missing, or is not this repo, means the machine was never
# bootstrapped (or was moved), and no amount of fetching will fix it.
if [ ! -f "$repo/run.sh" ] || [ ! -f "$repo/flake.nix" ]; then
  warn "$repo is not a dotfiles checkout (no run.sh/flake.nix), so there is nothing to apply."
  warn "bootstrap this machine with ./run.sh bootstrap first."
  exit 1
fi

if ! cd "$repo"; then
  warn "could not enter $repo, so nothing was applied."
  exit 1
fi

# --- which host this machine is ---------------------------------------

# Line one of .dotfiles-host, exactly as run.sh reads it (run.sh's $MARKER;
# line two is its nix/no-nix flag, which this job has no use for). Read
# with the shell rather than sed/head so the hermetic test suite does not
# have to put another binary on its PATH for it. `|| true` because a
# marker whose last line has no newline makes `read` report EOF while
# still setting the variable, and under `set -e` that would end the run.
host=""
IFS= read -r host <"$host_file" 2>/dev/null || true
# Trailing whitespace and a stray CR are not a different host.
host=${host%%[[:space:]]*}

case "$host" in
  personal-mac)
    # Announce only. See this file's header: the switch here needs root,
    # and a launchd user agent has no terminal to type a password at.
    mode=announce
    ;;
  home-linux)
    mode=apply
    ;;
  work)
    warn "$host_file says this is the 'work' host, which has no Nix switch to schedule."
    warn "the work host is applied by work/bootstrap.sh when you run it; nothing was fetched."
    exit 1
    ;;
  "")
    warn "$host_file does not exist (or is empty), so this machine has not recorded which host it is."
    warn "that is the same file ./run.sh reads to know which recipe it applies, and this job will not"
    warn "guess what ./run.sh would not. Record it once with: cd ~/.dotfiles && ./run.sh choose"
    exit 1
    ;;
  *)
    warn "$host_file names host '$host', which this job knows nothing about (it handles personal-mac"
    warn "and home-linux). Nothing was fetched. Re-record it with: cd ~/.dotfiles && ./run.sh choose"
    exit 1
    ;;
esac

# Only master is ever auto-applied. A checkout parked on a topic branch (or
# detached) is somebody's work in progress; fast-forwarding master from
# under it is exactly the kind of surprise this script must not spring.
current_branch=$(git symbolic-ref --quiet --short HEAD) || current_branch=""
if [ "$current_branch" != "$branch" ]; then
  log "checkout is on '${current_branch:-a detached HEAD}', not $branch, so it is left alone."
  exit 0
fi

# GIT_TERMINAL_PROMPT=0 so a host that cannot authenticate fails instead of
# blocking a scheduled job on a username prompt forever, and the low-speed
# settings so a half-open https connection gives up in seconds rather than
# leaving the job running until the next one is due. (An ssh remote has its
# own timeouts; those two settings are inert there.)
if ! fetch_output=$(
  GIT_TERMINAL_PROMPT=0 git \
    -c http.lowSpeedLimit=1000 \
    -c http.lowSpeedTime=15 \
    fetch --quiet "$remote" "$branch" 2>&1
); then
  warn "could not fetch $branch from $remote, so nothing was applied."
  warn "git said: $fetch_output"
  exit 1
fi

head_commit=$(git rev-parse HEAD)
remote_commit=$(git rev-parse "$remote_ref")

# Four outcomes, deliberately told apart rather than left to `git pull
# --ff-only`'s single exit status - each one is handled differently below.
if [ "$head_commit" = "$remote_commit" ]; then
  relation=current
elif git merge-base --is-ancestor "$head_commit" "$remote_commit"; then
  relation=behind
elif git merge-base --is-ancestor "$remote_commit" "$head_commit"; then
  relation=ahead
else
  relation=diverged
fi

if [ "$relation" = diverged ]; then
  warn "$branch and $remote/$branch have diverged - ${head_commit:0:12} and ${remote_commit:0:12} share no descent."
  warn "nothing was fetched into the working tree and nothing was applied; resolve it by hand in $repo."
  notify_once "diverged $head_commit $remote_commit" "dotfiles needs a hand" \
    "master and origin/master have diverged. Nothing was applied; resolve it in ~/.dotfiles."
  exit 1
fi

# What the last successful rebuild applied - written here on home-linux and
# by `./run.sh rebuild` itself on both Nix hosts, which is what lets the
# announce-only host find out that a human has caught up. Empty on a
# machine that has never run either, which is NOT treated as "rebuild
# now": installing the timer must not trigger a switch, or a notification,
# nobody asked for.
applied_commit=$(cat "$state_file" 2>/dev/null) || applied_commit=""

# The commit the announce-only host last raised a notification for. It is
# also the only thing that remembers, across runs, that an announcement is
# still outstanding on a machine that has never recorded an applied commit
# at all - see the update_due block below.
announced_commit=$(cat "$announce_file" 2>/dev/null) || announced_commit=""

record_applied() {
  if ! printf '%s\n' "$1" >"$state_file"; then
    warn "applied ${1:0:12} but could not record it in $state_file;"
    warn "harmless, but the next run will rebuild again rather than know this one succeeded."
  fi
}

# An update is outstanding when the fetch brought something to fast-forward
# to, or when this machine is not level with its own checkout - a previous
# rebuild that never completed, a commit made straight on local master, or
# (on personal-mac) an announcement nobody has acted on yet. The second
# half is what stops a failed rebuild from being forgotten the moment the
# fast-forward has already happened.
if [ "$relation" = behind ]; then
  update_due=1
elif [ -n "$applied_commit" ] && [ "$applied_commit" != "$head_commit" ]; then
  update_due=1
elif [ -n "$announced_commit" ] && [ "$announced_commit" != "$applied_commit" ]; then
  # An announcement already went out for a commit nobody has applied yet.
  # Without this, a Mac that has only ever been announced at (so it has no
  # applied commit recorded) would read as a machine running this for the
  # first time on its very next run, and go quiet about an update that is
  # still waiting.
  update_due=1
else
  update_due=0
fi

# Checked once, and never worked around: a fast-forward into a dirty tree
# is a conflict waiting to happen, and a rebuild from one would apply
# somebody's half-finished edit to the whole machine. Untracked files count
# (ignored ones do not) - a fast-forward that brings a file of the same name
# would fail anyway, and Nix reads untracked files straight into the flake.
dirty=$(git -c status.showUntrackedFiles=normal status --porcelain)
if [ -n "$dirty" ]; then
  if [ "$update_due" = 1 ]; then
    log "$remote/$branch is at ${remote_commit:0:12} and this checkout has uncommitted changes, so nothing was fast-forwarded or applied:"
    log "$dirty"
    log "commit, stash or discard them and the next run will pick it up."
    notify_once "dirty $head_commit $remote_commit" "dotfiles needs a hand" \
      "~/.dotfiles has uncommitted changes, so ${remote_commit:0:12} was not applied. Commit, stash or discard them."
  else
    # Nothing to fast-forward to, so the uncommitted work is in nobody's
    # way - an ordinary state, and not worth interrupting anyone about.
    log "nothing to apply (checkout is at ${head_commit:0:12}, with uncommitted changes)."
    clear_notified_once
  fi
  exit 0
fi

if [ "$relation" = behind ]; then
  if ! merge_output=$(git merge --ff-only "$remote_ref" 2>&1); then
    warn "could not fast-forward $branch to ${remote_commit:0:12}, so nothing was applied."
    warn "git said: $merge_output"
    exit 1
  fi
  log "fast-forwarded $branch from ${head_commit:0:12} to ${remote_commit:0:12}."
  head_commit=$remote_commit
  clear_notified_once
elif [ "$relation" = ahead ]; then
  # Unpushed local commits are not an incident, but they are a fetch this
  # job could not act on - so they say so once, rather than every half
  # hour, and the machine is still brought level with the checkout below.
  log "$branch is ahead of $remote/$branch (${head_commit:0:12} vs ${remote_commit:0:12}); nothing to fast-forward."
  notify_once "ahead $head_commit $remote_commit" "dotfiles needs a hand" \
    "master has commits that are not on origin/master, so there was nothing to fast-forward. Push them from ~/.dotfiles."
else
  clear_notified_once
fi

# A machine that has never run this and has nothing to fast-forward to
# records where it stands and stops: installing the timer must not trigger
# a switch, or a notification, nobody asked for. A first run that *did*
# have something to fast-forward to falls through and acts on it, which is
# the whole point.
if [ -z "$applied_commit" ] && [ "$update_due" = 0 ]; then
  log "first run on this machine: recording ${head_commit:0:12} as applied without rebuilding."
  record_applied "$head_commit"
  exit 0
fi

if [ "$update_due" = 0 ]; then
  log "already applied ${head_commit:0:12}; nothing to do."
  exit 0
fi

# --- personal-mac: announce, switch nothing ---------------------------

if [ "$mode" = announce ]; then
  # The log line and the notification are deliberately the same sentence -
  # whichever of the two you see, you see the command to run. The log line
  # is written on every run while the update is outstanding, because the
  # log is the record of what this machine knew when; the notification
  # fires once per new commit, because an interruption every half hour is
  # not a reminder, it is noise. Outstanding ends when `./run.sh rebuild`
  # records the commit it applied - that is the only thing that tells this
  # job a human has caught up.
  ready_message="an update is ready: ~/.dotfiles is at ${head_commit:0:12} and this machine has not applied it. Run: $rebuild_hint"
  log "$ready_message"

  if [ "$announced_commit" = "$head_commit" ]; then
    log "already notified about ${head_commit:0:12}; no second notification until master moves again."
    exit 0
  fi

  notify "dotfiles update ready" "$ready_message"
  if ! printf '%s\n' "$head_commit" >"$announce_file"; then
    warn "could not record the notification in $announce_file;"
    warn "harmless, but the next run will notify about ${head_commit:0:12} again."
  fi
  exit 0
fi

# --- home-linux: apply it ---------------------------------------------

if [ -n "$applied_commit" ]; then
  log "applying ${head_commit:0:12} with ./run.sh rebuild (last applied: ${applied_commit:0:12})."
else
  log "applying ${head_commit:0:12} with ./run.sh rebuild (nothing applied on this machine yet)."
fi

# A scheduled job inherits none of a login shell's environment, and `nix`
# needs more than PATH on a multi-user install (NIX_REMOTE above all, or a
# non-root client tries to use the store directly and fails on
# permissions). The daemon profile script is what a login shell sources to
# get that, and run.sh sources this very path itself right after
# installing Nix - so this is the same answer in the same place, skipped
# when something already set it or the file isn't there. `set +u` around it
# because that script is generated and not written to be read under `set
# -u`; its own failure must not take the run down either.
if [ -z "${NIX_REMOTE:-}" ] && [ -f /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]; then
  set +eu
  # shellcheck disable=SC1091
  . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
  set -eu
fi

# Nothing in this host's switch uses sudo - `./run.sh rebuild` here is a
# user-level `home-manager switch`. This is the floor under that promise:
# any sudo reached from the rebuild below resolves to a shim that prepends
# -n, so a rule that would need a password fails in milliseconds with
# sudo's own "a password is required" instead of a job with no terminal
# blocking on a prompt nobody can answer (a NOPASSWD rule still works
# exactly as before). The real sudo is resolved *before* the shim goes on
# PATH, and a resolution that lands inside the shim directory is declined,
# so a second call could not build a shim that execs itself.
install_sudo_guard() {
  local real dir=$state_dir/sudo-guard
  real=$(command -v sudo) || return 0
  case "$real" in
    "$dir"/*) return 0 ;;
  esac
  mkdir -p "$dir" || return 0
  {
    printf '%s\n' '#!/bin/sh'
    printf '%s\n' '# Written by dotfiles-auto-apply: a scheduled run has no terminal, so'
    printf '%s\n' '# sudo is never allowed to ask for a password here.'
    printf 'exec %s -n "$@"\n' "$real"
  } >"$dir/sudo" || return 0
  chmod +x "$dir/sudo" || return 0
  PATH=$dir:$PATH
  export PATH
  return 0
}

install_sudo_guard

# tee rather than a plain redirect so the switch's own output lands in both
# records, the same as every line above, and in a third file this script
# can read back - the only way to tell a rebuild that failed for an
# ordinary reason from one that failed for a password nobody can type.
# stdin is /dev/null so nothing inside the switch can block on a prompt
# either. The status is read out of PIPESTATUS rather than from the
# pipeline, so that it is run.sh's and only run.sh's: under `pipefail` a
# tee that could not write would read as a failed rebuild, which would
# notify about a switch that actually worked and then retry it every half
# hour.
#
# The third file is truncated first because tee appends to both: a run
# killed between the tee and the `rm` below would otherwise leave output
# for the next run to read back and blame the wrong thing on.
: >"$rebuild_out_file" || true
set +e
./run.sh rebuild </dev/null 2>&1 | tee -a "$log_file" "$rebuild_out_file"
rebuild_status=${PIPESTATUS[0]}
set -e

rebuild_output=$(cat "$rebuild_out_file" 2>/dev/null) || rebuild_output=""
rm -f "$rebuild_out_file" 2>/dev/null || true

if [ "$rebuild_status" != 0 ]; then
  warn "./run.sh rebuild failed, so this machine is still on the previous generation."
  warn "the checkout is at ${head_commit:0:12}; the rebuild is retried on the next run."
  case "$rebuild_output" in
    *"sudo: a password is required"* | *"sudo: a terminal is required"*)
      warn "it failed on a sudo password prompt, which a scheduled run has no terminal to answer."
      warn "sudo ran with -n, so it failed at once instead of blocking. Apply this one by hand:"
      warn "$rebuild_hint"
      ;;
  esac
  notify "dotfiles rebuild failed" "./run.sh rebuild failed for ${head_commit:0:12}. See ~/.local/state/dotfiles-auto/apply.log."
  exit 1
fi

record_applied "$head_commit"
log "applied ${head_commit:0:12}."
